/* =========================================================
   PROTEÇÃO FINAL
   ========================================================= */

.hf-dashboard,
.hf-dashboard *,
.hf-dashboard-kpis,
.hf-dashboard-secondary,
.hf-dashboard-attention,
.hf-dashboard-charts,
.hf-dashboard-bottom {
