* {
  box-sizing: border-box;
}

html,
body,
#root {
  margin: 0;
  min-height: 100%;
  width: 100%;
  font-family:
    Inter,
    Arial,
    Helvetica,
    sans-serif;
}

body {
  background: #f5f7fb;
  color: #14213d;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

.app {
  min-height: 100vh;
  display: flex;
  background: #f5f7fb;
}

/* SIDEBAR */

.sidebar {
  width: 232px;
  min-height: 100vh;
  background: #0d1728;
  color: #ffffff;
  padding: 26px 14px;
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 10px 30px;
}

.brand-logo {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  background: #ffffff;
  color: #0d1728;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 18px;
}

.brand-text {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.brand-text strong {
  font-size: 17px;
}

.brand-text span {
  color: #8d9bb1;
  font-size: 11px;
}

.navigation {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.nav {
  width: 100%;
  border: 0;
  background: transparent;
  color: #aeb9cb;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border-radius: 10px;
  font-size: 14px;
  text-align: left;
}

.nav:hover {
  background: #17243a;
  color: #ffffff;
}

.nav.active {
  background: #1b2b45;
  color: #ffffff;
}

/* MAIN */

.main {
  width: calc(100% - 232px);
  margin-left: 232px;
  padding: 32px 34px 50px;
  min-height: 100vh;
}

.topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 28px;
}

.topbar h1 {
  margin: 0;
  font-size: 28px;
  line-height: 1.2;
}

.topbar p {
  margin: 7px 0 0;
  color: #71809a;
  font-size: 14px;
}

/* BUTTONS */

.primary {
  border: 0;
  background: #111c31;
  color: #ffffff;
  border-radius: 9px;
  padding: 12px 17px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-weight: 700;
  transition: 0.2s;
}

.primary:hover {
  background: #1d2b46;
  transform: translateY(-1px);
}

.primary:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.secondary {
  border: 1px solid #d7deea;
  background: #ffffff;
  color: #26344d;
  border-radius: 9px;
  padding: 11px 17px;
  font-weight: 600;
}

.secondary:hover {
  background: #f5f7fb;
}

/* FILTERS */

.filters {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 22px;
}

.search-box {
  height: 40px;
  flex: 1;
  min-width: 250px;
  display: flex;
  align-items: center;
  gap: 9px;
  background: #ffffff;
  border: 1px solid #dce2ec;
  border-radius: 8px;
  padding: 0 12px;
  color: #8a98ad;
}

.search-box input {
  border: 0;
  outline: 0;
  width: 100%;
  background: transparent;
  color: #17243a;
}

.filters select {
  height: 40px;
  min-width: 125px;
  border: 1px solid #dce2ec;
  background: #ffffff;
  border-radius: 8px;
  padding: 0 12px;
  color: #26344d;
  outline: none;
}

.filter-label {
  display: flex;
  align-items: center;
  gap: 5px;
  color: #71809a;
  font-size: 13px;
  white-space: nowrap;
}

/* CARDS */

.cards {
  display: grid;
  grid-template-columns:
    repeat(4, minmax(0, 1fr));
  gap: 14px;
  margin-bottom: 14px;
}

.card {
  background: #ffffff;
  border: 1px solid #e0e5ee;
  border-radius: 11px;
  padding: 18px;
  min-height: 125px;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #71809a;
  font-size: 13px;
}

.card-icon {
  color: #17243a;
}

.card > strong {
  display: block;
  margin-top: 18px;
  font-size: 28px;
}

/* DASHBOARD */

.dashboard-panels {
  display: grid;
  grid-template-columns:
    1fr 1fr;
  gap: 14px;
  margin-bottom: 14px;
}

.panel {
  background: #ffffff;
  border: 1px solid #e0e5ee;
  border-radius: 11px;
  padding: 20px;
}

.panel h2 {
  margin: 0;
  font-size: 20px;
}

.panel-subtitle {
  margin: 7px 0 20px;
  color: #7a879c;
  font-size: 13px;
}

.status-list {
  display: flex;
  flex-direction: column;
  gap: 13px;
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 14px;
}

.status-row span {
  color: #53627a;
}

.big-hours {
  margin-top: 10px;
  font-size: 42px;
  font-weight: 800;
}

.summary-grid {
  display: grid;
  grid-template-columns:
    repeat(3, 1fr);
  gap: 12px;
  margin-top: 28px;
}

.summary-grid div {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.summary-grid strong {
  font-size: 20px;
}

.summary-grid span {
  color: #7a879c;
  font-size: 12px;
}

/* TABLE */

.demands-panel {
  padding: 0;
  overflow: hidden;
}

.panel-title {
  padding: 22px 20px;
}

.panel-title h2 {
  margin: 0;
  font-size: 21px;
}

.panel-title p {
  margin: 7px 0 0;
  color: #71809a;
  font-size: 13px;
}

.table-container {
  width: 100%;
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  min-width: 1200px;
}

thead {
  background: #f8f9fc;
}

th {
  text-align: left;
  padding: 13px 12px;
  border-top: 1px solid #e7ebf2;
  border-bottom: 1px solid #e7ebf2;
  color: #60708a;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  white-space: nowrap;
}

td {
  padding: 15px 12px;
  border-bottom: 1px solid #edf0f5;
  color: #27354d;
  font-size: 13px;
  vertical-align: middle;
}

tbody tr:hover {
  background: #fafbfe;
}

.priority,
.status,
.approved {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  white-space: nowrap;
}

.priority {
  color: #44536c;
}

.priority-alta {
  color: #b45309;
  font-weight: 700;
}

.priority-urgente {
  color: #b91c1c;
  font-weight: 700;
}

.status {
  color: #44536c;
}

.approved {
  color: #15803d;
  font-weight: 700;
}

/* ACTIONS */

.action {
  border: 0;
  border-radius: 7px;
  padding: 7px 10px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  font-size: 12px;
  font-weight: 700;
  white-space: nowrap;
}

.action.edit {
  background: #eef2ff;
  color: #3346a8;
}

.action.edit:hover {
  background: #e0e7ff;
}

.action.approve {
  background: #ecfdf3;
  color: #15803d;
}

.action.approve:hover {
  background: #d1fae5;
}

/* EMPTY */

.empty {
  min-height: 250px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  color: #8290a5;
}

.empty strong {
  color: #334155;
  font-size: 15px;
}

.empty span {
  font-size: 13px;
}

/* MODAL */

.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.58);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  z-index: 1000;
}

.modal {
  width: min(720px, 100%);
  max-height: 90vh;
  background: #ffffff;
  border-radius: 16px;
  box-shadow:
    0 25px 60px
    rgba(15, 23, 42, 0.25);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  padding: 25px 28px 20px;
  border-bottom: 1px solid #e8ecf2;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 15px;
}

.modal-header h2 {
  margin: 0;
  font-size: 25px;
}

.modal-header p {
  margin: 6px 0 0;
  color: #71809a;
  font-size: 13px;
}

.close-button {
  width: 38px;
  height: 38px;
  border: 1px solid #dce2ec;
  background: #ffffff;
  border-radius: 8px;
  color: #334155;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-button:hover {
  background: #f4f6f9;
}

.modal-body {
  padding: 25px 28px;
  overflow-y: auto;
}

.form-row {
  display: grid;
  grid-template-columns:
    1fr 1fr;
  gap: 18px;
}

.form-field {
  margin-bottom: 18px;
}

.form-field.full {
  width: 100%;
}

.form-field label {
  display: block;
  margin-bottom: 7px;
  color: #334155;
  font-size: 13px;
  font-weight: 700;
}

.form-field input,
.form-field textarea,
.form-field select {
  width: 100%;
  border: 1px solid #d7deea;
  border-radius: 8px;
  background: #ffffff;
  color: #25334b;
  outline: none;
  padding: 11px 12px;
}

.form-field input,
.form-field select {
  height: 43px;
}

.form-field textarea {
  min-height: 105px;
  resize: vertical;
}

.form-field input:focus,
.form-field textarea:focus,
.form-field select:focus {
  border-color: #63759a;
  box-shadow:
    0 0 0 3px
    rgba(99, 117, 154, 0.12);
}

.form-field input::placeholder,
.form-field textarea::placeholder {
  color: #a2adbd;
}

.modal-footer {
  padding: 17px 28px;
  border-top: 1px solid #e8ecf2;
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  background: #ffffff;
}

/* RESPONSIVO */

@media (max-width: 1000px) {
  .sidebar {
    width: 190px;
  }

  .main {
    width: calc(100% - 190px);
    margin-left: 190px;
    padding: 25px;
  }

  .cards {
    grid-template-columns:
      repeat(2, 1fr);
  }

  .dashboard-panels {
    grid-template-columns: 1fr;
  }

  .filters {
    flex-wrap: wrap;
  }

  .search-box {
    flex-basis: 100%;
  }
}

@media (max-width: 700px) {
  .sidebar {
    position: static;
    width: 100%;
    min-height: auto;
  }

  .app {
    flex-direction: column;
  }

  .main {
    width: 100%;
    margin-left: 0;
    padding: 20px;
  }

  .topbar {
    flex-direction: column;
  }

  .cards {
    grid-template-columns: 1fr;
  }

  .form-row {
    grid-template-columns: 1fr;
    gap: 0;
  }

  .modal {
    max-height: 95vh;
  }

  .modal-header,
  .modal-body,
  .modal-footer {
    padding-left: 18px;
    padding-right: 18px;
  }
}
/* =========================================================
   RESPONSIVIDADE GLOBAL - VERSÃO FINAL
   ========================================================= */

/* ---------- BASE ---------- */

*,
*::before,
*::after {
  box-sizing: border-box;
}

html,
body,
#root {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  margin: 0;
}

body {
  overflow-x: hidden;
}

.hf-app {
  width: 100%;
  min-height: 100vh;
  min-width: 0;
  display: flex;
  overflow-x: hidden;
}

.hf-main {
  flex: 1 1 auto;
  width: auto;
  min-width: 0;
  max-width: 100%;
  overflow-x: hidden;
}

.hf-content {
  width: 100%;
  min-width: 0;
  max-width: 100%;
}

/* =========================================================
   SIDEBAR + ÁREA PRINCIPAL
   ========================================================= */

.hf-sidebar {
  flex: 0 0 240px;
  width: 240px;
  min-width: 240px;
  max-width: 240px;
}

.hf-main {
  flex: 1 1 auto;
  min-width: 0;
}

/* =========================================================
   FILTROS
   ========================================================= */

.hf-filters {
  width: 100%;
  max-width: 100%;
  min-width: 0;

  display: flex;
  flex-wrap: wrap;
  align-items: center;

  gap: 10px;

  overflow: visible;
}

.hf-filters > * {
  min-width: 0;
  max-width: 100%;
}

.hf-filters input,
.hf-filters select,
.hf-filters button {
  box-sizing: border-box;
  max-width: 100%;
}

/* Campo de busca */
.hf-search {
  flex: 1 1 300px;
  min-width: 220px;
  max-width: 100%;
}

.hf-search input {
  width: 100%;
  min-width: 0;
}

/* Filtros select */
.hf-filters > select {
  flex: 1 1 150px;
  min-width: 120px;
}

/* Filtro de execução */
.hf-filter-month {
  flex: 1 1 220px;
  min-width: 180px;
  max-width: 280px;
}

.hf-filter-month input[type="month"] {
  width: 100%;
  min-width: 0;
  max-width: 100%;
}

/* Contador */
.hf-filter-count {
  flex: 0 1 auto;
  min-width: 0;
  white-space: nowrap;
}

/* =========================================================
   PAINÉIS
   ========================================================= */

.hf-panel {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.hf-panel-title {
  width: 100%;
  max-width: 100%;
  min-width: 0;

  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
}

.hf-panel-title > * {
  min-width: 0;
  max-width: 100%;
}

.hf-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  min-width: 0;
  max-width: 100%;
}

.hf-actions button {
  max-width: 100%;
}

/* =========================================================
   TABELA
   ========================================================= */

.hf-table-wrap {
  display: block;

  width: 100%;
  max-width: 100%;
  min-width: 0;

  overflow-x: auto;
  overflow-y: hidden;

  -webkit-overflow-scrolling: touch;
}

.hf-table-wrap table {
  width: max-content;
  min-width: 1100px;
  max-width: none;
}

/* =========================================================
   MODAIS
   ========================================================= */

.hf-modal-backdrop {
  position: fixed;

  inset: 0;

  width: 100vw;
  height: 100vh;

  max-width: 100vw;
  max-height: 100vh;

  padding: 20px;

  display: flex;
  align-items: center;
  justify-content: center;

  overflow-x: hidden;
  overflow-y: auto;

  box-sizing: border-box;

  z-index: 9999;
}

.hf-modal {
  width: min(700px, calc(100vw - 40px));
  max-width: calc(100vw - 40px);

  min-width: 0;
  max-height: calc(100vh - 40px);

  box-sizing: border-box;

  overflow-x: hidden;
  overflow-y: auto;
}

.hf-decision-modal {
  width: min(590px, calc(100vw - 40px));
  max-width: calc(100vw - 40px);

  min-width: 0;
  max-height: calc(100vh - 40px);

  box-sizing: border-box;

  overflow-x: hidden;
  overflow-y: auto;
}

.hf-modal *,
.hf-decision-modal * {
  box-sizing: border-box;
  min-width: 0;
  max-width: 100%;
}

.hf-modal input,
.hf-modal select,
.hf-modal textarea,
.hf-decision-modal input,
.hf-decision-modal select,
.hf-decision-modal textarea {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

/* =========================================================
   IMAGENS / SVG
   ========================================================= */

img,
svg,
video,
canvas {
  max-width: 100%;
}

/* =========================================================
   NOTEBOOK
   Até 1200px
   ========================================================= */

@media (max-width: 1200px) {

  .hf-sidebar {
    flex-basis: 210px;
    width: 210px;
    min-width: 210px;
    max-width: 210px;
  }

  .hf-main {
    min-width: 0;
  }

  .hf-content {
    padding-left: 20px;
    padding-right: 20px;
  }

  .hf-filters {
    display: grid;
    grid-template-columns:
      minmax(220px, 2fr)
      repeat(3, minmax(130px, 1fr));
  }

  .hf-search {
    width: 100%;
    min-width: 0;
  }

  .hf-filters > select {
    width: 100%;
    min-width: 0;
  }

  .hf-filter-month {
    width: 100%;
    max-width: none;
    min-width: 0;
  }

  .hf-filter-count {
    width: auto;
  }
}

/* =========================================================
   TABLET
   Até 900px
   ========================================================= */

@media (max-width: 900px) {

  .hf-sidebar {
    flex: 0 0 76px;
    width: 76px;
    min-width: 76px;
    max-width: 76px;
  }

  .hf-main {
    width: calc(100% - 76px);
    min-width: 0;
  }

  .hf-content {
    padding-left: 16px;
    padding-right: 16px;
  }

  .hf-filters {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: 100%;
  }

  .hf-search,
  .hf-filters > select,
  .hf-filter-month,
  .hf-filter-count {
    width: 100%;
    min-width: 0;
    max-width: none;
  }

  .hf-filter-count {
    white-space: normal;
  }

  .hf-table-wrap {
    width: 100%;
    max-width: 100%;
  }

  .hf-modal-backdrop {
    padding: 16px;
  }

  .hf-modal,
  .hf-decision-modal {
    width: min(590px, calc(100vw - 32px));
    max-width: calc(100vw - 32px);
  }
}

/* =========================================================
   CELULAR
   Até 600px
   ========================================================= */

@media (max-width: 600px) {

  .hf-sidebar {
    display: none;
  }

  .hf-main {
    width: 100%;
    max-width: 100%;
  }

  .hf-content {
    width: 100%;
    max-width: 100%;
    padding: 12px;
  }

  .hf-filters {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .hf-filters > *,
  .hf-search,
  .hf-filter-month,
  .hf-filter-count {
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }

  .hf-filter-count {
    white-space: normal;
  }

  .hf-panel-title {
    align-items: flex-start;
  }

  .hf-actions {
    width: 100%;
    flex-direction: column;
  }

  .hf-actions button {
    width: 100%;
  }

  .hf-table-wrap {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
  }

  .hf-table-wrap table {
    min-width: 900px;
  }

  /* Modal */
  .hf-modal-backdrop {
    padding: 10px;
    align-items: flex-start;
  }

  .hf-modal,
  .hf-decision-modal {
    width: 100%;
    max-width: 100%;
    max-height: calc(100vh - 20px);
  }
}

/* =========================================================
   CELULARES PEQUENOS
   Até 380px
   ========================================================= */

@media (max-width: 380px) {

  .hf-content {
    padding: 8px;
  }

  .hf-modal-backdrop {
    padding: 6px;
  }

  .hf-modal,
  .hf-decision-modal {
    width: 100%;
    max-width: 100%;
  }

  .hf-table-wrap table {
    min-width: 850px;
  }
}

/* =========================================================
   PROTEÇÃO CONTRA OVERFLOW
   ========================================================= */

.hf-app,
.hf-main,
.hf-content,
.hf-panel,
.hf-panel-title,
.hf-filters,
.hf-actions {
  min-width: 0;
}


/* =========================================================
   DASHBOARD — NOVO LAYOUT GERENCIAL
   Apenas visual / responsividade
   ========================================================= */

/* Área geral da dashboard */
.hf-dashboard {
  width: 100%;
  max-width: 100%;
  min-width: 0;
}

/* =========================================================
   FILTROS DA DASHBOARD
   ========================================================= */

.hf-dashboard .hf-filters {
  width: 100%;
  display: grid;
  grid-template-columns:
    minmax(220px, 1.6fr)
    minmax(180px, 1fr)
    auto
    auto;

  gap: 10px;
  align-items: center;

  padding: 14px;
  margin-bottom: 20px;

  box-sizing: border-box;
}

.hf-dashboard .hf-filters > * {
  min-width: 0;
  max-width: 100%;
}

/* =========================================================
   KPIs
   ========================================================= */

.hf-dashboard-kpis {
  display: grid !important;

  grid-template-columns:
    repeat(4, minmax(0, 1fr)) !important;

  gap: 14px !important;

  width: 100% !important;
  min-width: 0 !important;
  margin-bottom: 14px !important;
}

.hf-dashboard-kpis > * {
  min-width: 0 !important;
  width: 100% !important;
  box-sizing: border-box !important;
}

/* Cards principais */
.hf-dashboard-kpi {
  position: relative;

  min-height: 142px;

  padding: 20px !important;

  border-radius: 16px !important;

  display: flex;
  flex-direction: column;
  justify-content: space-between;

  overflow: hidden;

  transition:
    transform .18s ease,
    box-shadow .18s ease;
}

.hf-dashboard-kpi:hover {
  transform: translateY(-2px);

  box-shadow:
    0 10px 30px rgba(15, 23, 42, .08);
}

/* Número */
.hf-dashboard-kpi strong,
.hf-dashboard-kpi .value,
.hf-dashboard-kpi-value {
  font-size: clamp(28px, 3vw, 38px) !important;
  line-height: 1 !important;
  font-weight: 800 !important;
}

/* =========================================================
   SEGUNDA LINHA DE INDICADORES
   ========================================================= */

.hf-dashboard-secondary {
  display: grid !important;

  grid-template-columns:
    repeat(4, minmax(0, 1fr)) !important;

  gap: 14px !important;

  width: 100% !important;
  margin-bottom: 20px !important;
}

.hf-dashboard-secondary > * {
  min-width: 0 !important;
}

/* =========================================================
   BLOCO DE ATENÇÃO
   ========================================================= */

.hf-dashboard-attention {
  display: grid;

  grid-template-columns:
    minmax(0, 1.4fr)
    minmax(300px, 1fr);

  gap: 16px;

  width: 100%;

  margin-bottom: 20px;
}

.hf-dashboard-attention > * {
  min-width: 0;
}

/* =========================================================
   CARD "REQUER ATENÇÃO"
   ========================================================= */

.hf-attention-card {
  padding: 20px;

  border-radius: 16px;

  background: #fff;

  border: 1px solid #e5e7eb;

  box-sizing: border-box;
}

.hf-attention-title {
  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 12px;

  margin-bottom: 16px;
}

.hf-attention-title h3 {
  margin: 0;

  font-size: 17px;
  font-weight: 750;
}

.hf-attention-list {
  display: flex;

  flex-direction: column;

  gap: 10px;
}

.hf-attention-item {
  display: flex;

  align-items: center;

  gap: 12px;

  padding: 11px 12px;

  border-radius: 10px;

  background: #f8fafc;

  min-width: 0;
}

.hf-attention-dot {
  flex: 0 0 9px;

  width: 9px;
  height: 9px;

  border-radius: 50%;

  background: #94a3b8;
}

.hf-attention-content {
  min-width: 0;

  flex: 1;
}

.hf-attention-content strong {
  display: block;

  font-size: 13px;
  font-weight: 700;
}

.hf-attention-content span {
  display: block;

  margin-top: 2px;

  font-size: 12px;

  color: #64748b;
}

/* =========================================================
   RESUMO DE HORAS
   ========================================================= */

.hf-hours-summary {
  padding: 20px;

  border-radius: 16px;

  background: #fff;

  border: 1px solid #e5e7eb;

  box-sizing: border-box;
}

.hf-hours-summary h3 {
  margin: 0 0 18px;

  font-size: 17px;
}

.hf-hours-total {
  font-size: clamp(30px, 3vw, 42px);

  line-height: 1;

  font-weight: 800;

  margin-bottom: 14px;
}

.hf-hours-progress {
  width: 100%;

  height: 9px;

  overflow: hidden;

  border-radius: 999px;

  background: #e9eef5;
}

.hf-hours-progress > div {
  height: 100%;

  width: var(--hours-progress, 40%);

  border-radius: inherit;

  background: #315bea;
}

/* =========================================================
   GRÁFICOS / PAINÉIS
   ========================================================= */

.hf-dashboard-charts {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(0, 1fr);

  gap: 16px;

  width: 100%;

  margin-bottom: 20px;
}

.hf-dashboard-chart {
  min-width: 0;

  width: 100%;

  padding: 20px;

  border-radius: 16px;

  background: #fff;

  border: 1px solid #e5e7eb;

  box-sizing: border-box;
}

.hf-dashboard-chart-header {
  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 12px;

  margin-bottom: 18px;
}

.hf-dashboard-chart-header h3 {
  margin: 0;

  font-size: 17px;

  font-weight: 750;
}

/* =========================================================
   BARRAS DE STATUS
   ========================================================= */

.hf-status-list {
  display: flex;

  flex-direction: column;

  gap: 14px;
}

.hf-status-row {
  display: grid;

  grid-template-columns:
    minmax(120px, 170px)
    minmax(0, 1fr)
    35px;

  align-items: center;

  gap: 10px;

  min-width: 0;
}

.hf-status-label {
  overflow: hidden;

  text-overflow: ellipsis;

  white-space: nowrap;

  font-size: 13px;
}

.hf-status-bar {
  width: 100%;

  height: 8px;

  overflow: hidden;

  border-radius: 999px;

  background: #edf1f7;
}

.hf-status-bar > div {
  height: 100%;

  width: var(--status-width, 30%);

  border-radius: inherit;

  background: #315bea;
}

.hf-status-number {
  text-align: right;

  font-size: 13px;

  font-weight: 700;
}

/* =========================================================
   HORAS POR PERÍODO
   ========================================================= */

.hf-hours-chart {
  display: flex;

  align-items: flex-end;

  gap: 14px;

  height: 210px;

  padding-top: 15px;

  overflow-x: auto;
}

.hf-hours-column {
  flex: 1 0 42px;

  min-width: 42px;

  height: 100%;

  display: flex;

  flex-direction: column;

  justify-content: flex-end;

  align-items: center;

  gap: 7px;
}

.hf-hours-column-bar {
  width: min(42px, 100%);

  height: var(--hours-height, 40%);

  min-height: 4px;

  border-radius: 7px 7px 3px 3px;

  background: #315bea;

  transition: height .25s ease;
}

.hf-hours-column span {
  font-size: 11px;

  color: #64748b;

  white-space: nowrap;
}

.hf-hours-column strong {
  font-size: 11px;
}

/* =========================================================
   CLIENTES + ÚLTIMAS DEMANDAS
   ========================================================= */

.hf-dashboard-bottom {
  display: grid;

  grid-template-columns:
    minmax(0, .9fr)
    minmax(0, 1.5fr);

  gap: 16px;

  width: 100%;

  margin-bottom: 30px;
}

.hf-dashboard-bottom > * {
  min-width: 0;
}

.hf-dashboard-list {
  width: 100%;

  padding: 20px;

  border-radius: 16px;

  background: #fff;

  border: 1px solid #e5e7eb;

  box-sizing: border-box;
}

.hf-dashboard-list h3 {
  margin: 0 0 18px;

  font-size: 17px;
}

/* =========================================================
   CLIENTES
   ========================================================= */

.hf-client-row {
  display: grid;

  grid-template-columns:
    minmax(90px, 1fr)
    minmax(0, 2fr)
    35px;

  align-items: center;

  gap: 10px;

  margin-bottom: 12px;
}

.hf-client-row:last-child {
  margin-bottom: 0;
}

.hf-client-name {
  overflow: hidden;

  text-overflow: ellipsis;

  white-space: nowrap;

  font-size: 13px;
}

.hf-client-bar {
  height: 7px;

  border-radius: 999px;

  background: #edf1f7;

  overflow: hidden;
}

.hf-client-bar > div {
  height: 100%;

  width: var(--client-width, 40%);

  border-radius: inherit;

  background: #315bea;
}

.hf-client-count {
  text-align: right;

  font-size: 12px;

  font-weight: 700;
}

/* =========================================================
   ÚLTIMAS DEMANDAS
   ========================================================= */

.hf-recent-demand {
  display: grid;

  grid-template-columns:
    60px
    minmax(0, 1fr)
    auto
    auto;

  align-items: center;

  gap: 12px;

  padding: 11px 0;

  border-bottom: 1px solid #eef2f7;

  min-width: 0;
}

.hf-recent-demand:last-child {
  border-bottom: 0;
}

.hf-recent-number {
  font-weight: 750;

  color: #315bea;
}

.hf-recent-title {
  min-width: 0;

  overflow: hidden;

  text-overflow: ellipsis;

  white-space: nowrap;

  font-size: 13px;
}

.hf-recent-meta {
  white-space: nowrap;

  font-size: 12px;

  color: #64748b;
}

/* =========================================================
   RESPONSIVIDADE — DESKTOP
   ========================================================= */

@media (max-width: 1200px) {

  .hf-dashboard-kpis {
    grid-template-columns:
      repeat(2, minmax(0, 1fr)) !important;
  }

  .hf-dashboard-secondary {
    grid-template-columns:
      repeat(2, minmax(0, 1fr)) !important;
  }

  .hf-dashboard-attention {
    grid-template-columns: 1fr;
  }

  .hf-dashboard-bottom {
    grid-template-columns: 1fr;
  }
}

/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 900px) {

  .hf-dashboard .hf-filters {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));

  }

  .hf-dashboard-charts {
    grid-template-columns: 1fr;
  }

  .hf-dashboard-kpis,
  .hf-dashboard-secondary {
    grid-template-columns:
      repeat(2, minmax(0, 1fr)) !important;
  }

  .hf-status-row {
    grid-template-columns:
      minmax(100px, 140px)
      minmax(0, 1fr)
