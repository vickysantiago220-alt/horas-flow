  }
}

/* =========================================================
   CELULAR
   ========================================================= */

@media (max-width: 600px) {

  .hf-dashboard .hf-filters {
    grid-template-columns: 1fr;

    padding: 10px;

    gap: 8px;
  }

  .hf-dashboard-kpis,
