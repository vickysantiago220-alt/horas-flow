/* =========================================================
   RESET
   ========================================================= */

* {
  box-sizing: border-box;
}

html,
body,
#root {
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
}

body {
  overflow-x: hidden;
}


/* =========================================================
   ESTRUTURA PRINCIPAL
   ========================================================= */

.hf-app {
  width: 100%;
  min-width: 0;
  overflow-x: hidden;
}

.hf-main {
  width: 100%;
  min-width: 0;
  max-width: 100%;
}

.hf-content {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
}


/* =========================================================
   FILTROS - DESKTOP
   Buscar | Status | Aprovações | Clientes | Períodos | Execução
   ========================================================= */

.hf-filters {
  width: 100%;
  max-width: 100%;
  min-width: 0;

  display: grid;

  grid-template-columns:
    1.15fr
    1fr
    1fr
    1.55fr
    1fr
    1.35fr;

  gap: 8px;

  align-items: center;

  overflow: hidden;

  box-sizing: border-box;
}

/* Todos os campos */
.hf-filters > *,
.hf-filters .hf-search,
.hf-filters .hf-filter-month {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
}

/* Busca */
.hf-filters .hf-search {
  display: flex;
  align-items: center;
  min-width: 0;
  overflow: hidden;
}

.hf-filters .hf-search input {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
}

/* Selects */
.hf-filters > select {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
}

/* Filtro Execução */
.hf-filters .hf-filter-month {
  display: flex;
  align-items: center;
  gap: 4px;
  min-width: 0;
  overflow: hidden;
}

.hf-filters .hf-filter-month > * {
  min-width: 0;
  max-width: 100%;
}

.hf-filters .hf-filter-month input {
  min-width: 0;
  max-width: 100%;
  flex: 1 1 auto;
}

/* Não mostrar contador dentro da barra */
.hf-filters .hf-filter-count {
  display: none;
}


/* =========================================================
   NOTEBOOK / TELAS MENORES
   ========================================================= */

@media (min-width: 901px) and (max-width: 1200px) {

  .hf-filters {
    grid-template-columns:
      1.05fr
      .9fr
      .95fr
      1.3fr
      .9fr
      1.15fr;

    gap: 6px;
  }

}


/* =========================================================
   TABLET
   ========================================================= */

@media (min-width: 601px) and (max-width: 900px) {

  .hf-filters {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

}


/* =========================================================
   CELULAR
   ========================================================= */

@media (max-width: 600px) {

  .hf-filters {
    display: grid;
    grid-template-columns: 1fr;
    width: 100%;
    gap: 8px;
  }

  .hf-filters > *,
  .hf-filters .hf-search,
  .hf-filters .hf-filter-month {
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }

}
/* =========================================================
   ELEMENTOS DOS FILTROS
   ========================================================= */

.hf-filters > * {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
}


/* =========================================================
   BUSCA
   ========================================================= */

.hf-filters .hf-search {
  width: 100%;
  min-width: 0;
  max-width: 100%;

  box-sizing: border-box;
}

.hf-filters .hf-search input {
  width: 100%;
  min-width: 0;
  max-width: 100%;

  box-sizing: border-box;
}


/* =========================================================
   SELECTS
   ========================================================= */

.hf-filters > select {
  width: 100%;
  min-width: 0;
  max-width: 100%;

  box-sizing: border-box;
}


/* =========================================================
   EXECUÇÃO
   ========================================================= */

.hf-filters .hf-filter-month {
  width: 100%;
  min-width: 0;
  max-width: 100%;

  display: flex;
  align-items: center;

  gap: 5px;

  overflow: hidden;

  box-sizing: border-box;
}

.hf-filters .hf-filter-month span,
.hf-filters .hf-filter-month label {
  flex: 0 0 auto;
  white-space: nowrap;
}

.hf-filters .hf-filter-month input,
.hf-filters .hf-filter-month input[type="month"] {
  width: 100%;
  min-width: 0;
  max-width: 100%;

  flex: 1 1 auto;

  box-sizing: border-box;
}


/* =========================================================
   CONTADOR
   ========================================================= */

.hf-filters .hf-filter-count {
  display: none;
}


/* =========================================================
   TABELA
   ========================================================= */

.hf-table-wrap {
  width: 100%;
  max-width: 100%;

  overflow-x: auto;
  overflow-y: visible;

  box-sizing: border-box;
}

.hf-table-wrap table {
  width: 100%;
  min-width: 1100px;

  border-collapse: collapse;
}


/* =========================================================
   RESPONSIVIDADE — NOTEBOOK
   901px até 1200px
   ========================================================= */

@media (min-width: 901px) and (max-width: 1200px) {

  .hf-filters {
    grid-template-columns:
      minmax(125px, 1.1fr)
      minmax(105px, 1fr)
      minmax(115px, 1fr)
      minmax(135px, 1.2fr)
      minmax(105px, 1fr)
      minmax(165px, 1.25fr);

    gap: 6px;
  }
}


/* =========================================================
   TABLET
   601px até 900px
   ========================================================= */

@media (min-width: 601px) and (max-width: 900px) {

  .hf-filters {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 8px;
  }

  .hf-filters > * {
    width: 100%;
    min-width: 0;
  }
}


/* =========================================================
   CELULAR
   até 600px
   ========================================================= */

@media (max-width: 600px) {

  .hf-main,
  .hf-content {
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  .hf-filters {
    grid-template-columns: 1fr;

    width: 100%;

    gap: 8px;
  }

  .hf-filters > *,
  .hf-filters .hf-search,
  .hf-filters .hf-filter-month {
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }

  .hf-table-wrap {
    width: 100%;
    max-width: 100%;

    overflow-x: auto;
  }
}/* =========================================================
   FILTROS — VISUAL CLEAN / SAPPHIRE SHEET
   ========================================================= */

.hf-filters-clean {
  display: flex !important;
  align-items: center !important;
  gap: 12px !important;
  padding: 10px !important;
}

.hf-filters-clean .hf-search {
  flex: 1 !important;
  min-width: 0 !important;
}

.hf-filter-trigger {
  height: 42px !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px !important;

  padding: 0 16px !important;

  border: 1px solid #dce3ee !important;
  border-radius: 10px !important;

  background: #ffffff !important;
  color: #344054 !important;

  font-size: 14px !important;
  font-weight: 600 !important;

  cursor: pointer !important;
  transition: all .18s ease !important;
}

.hf-filter-trigger:hover {
  border-color: #b8c7e6 !important;
  background: #f8faff !important;
  color: #2f5bea !important;
}

.hf-filter-trigger svg {
  width: 17px !important;
  height: 17px !important;
}

/* =========================================================
   BACKDROP
   ========================================================= */

.hf-filter-modal-backdrop {
  position: fixed !important;
  inset: 0 !important;
  z-index: 9999 !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  padding: 24px !important;
  box-sizing: border-box !important;

  background: rgba(15, 23, 42, .42) !important;
  backdrop-filter: blur(5px) !important;
}

/* =========================================================
   MODAL
   ========================================================= */

.hf-filter-modal {
  width: min(680px, calc(100vw - 48px)) !important;
  max-width: 680px !important;

  max-height: calc(100vh - 48px) !important;

  display: flex !important;
  flex-direction: column !important;

  overflow: hidden !important;

  background: #ffffff !important;

  border: 1px solid #e4e9f2 !important;
  border-radius: 18px !important;

  box-shadow:
    0 24px 70px rgba(15, 23, 42, .18),
    0 4px 14px rgba(15, 23, 42, .08) !important;

  animation: hfFilterModalIn .18s ease-out !important;
}

@keyframes hfFilterModalIn {
  from {
    opacity: 0;
    transform: translateY(8px) scale(.985);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

