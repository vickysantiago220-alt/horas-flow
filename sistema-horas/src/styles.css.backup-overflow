* {
  box-sizing: border-box;
}

html,
body,
#root {
  margin: 0;
  min-height: 100%;
  width: 100%;
  font-family:
    Inter,
    Arial,
    Helvetica,
    sans-serif;
}

body {
  background: #f5f7fb;
  color: #14213d;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

.app {
  min-height: 100vh;
  display: flex;
  background: #f5f7fb;
}

/* SIDEBAR */

.sidebar {
  width: 232px;
  min-height: 100vh;
  background: #0d1728;
  color: #ffffff;
  padding: 26px 14px;
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 10px 30px;
}

.brand-logo {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  background: #ffffff;
  color: #0d1728;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 18px;
}

.brand-text {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.brand-text strong {
  font-size: 17px;
}

.brand-text span {
  color: #8d9bb1;
  font-size: 11px;
}

.navigation {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.nav {
  width: 100%;
  border: 0;
  background: transparent;
  color: #aeb9cb;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border-radius: 10px;
  font-size: 14px;
  text-align: left;
}

.nav:hover {
  background: #17243a;
  color: #ffffff;
}

.nav.active {
  background: #1b2b45;
  color: #ffffff;
}

/* MAIN */

.main {
  width: calc(100% - 232px);
  margin-left: 232px;
  padding: 32px 34px 50px;
  min-height: 100vh;
}

.topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 28px;
}

.topbar h1 {
  margin: 0;
  font-size: 28px;
  line-height: 1.2;
}

.topbar p {
  margin: 7px 0 0;
  color: #71809a;
  font-size: 14px;
}

/* BUTTONS */

.primary {
  border: 0;
  background: #111c31;
  color: #ffffff;
  border-radius: 9px;
  padding: 12px 17px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-weight: 700;
  transition: 0.2s;
}

.primary:hover {
  background: #1d2b46;
  transform: translateY(-1px);
}

.primary:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.secondary {
  border: 1px solid #d7deea;
  background: #ffffff;
  color: #26344d;
  border-radius: 9px;
  padding: 11px 17px;
  font-weight: 600;
}

.secondary:hover {
  background: #f5f7fb;
}

/* FILTERS */

.filters {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 22px;
}

.search-box {
  height: 40px;
  flex: 1;
  min-width: 250px;
  display: flex;
  align-items: center;
  gap: 9px;
  background: #ffffff;
  border: 1px solid #dce2ec;
  border-radius: 8px;
  padding: 0 12px;
  color: #8a98ad;
}

.search-box input {
  border: 0;
  outline: 0;
  width: 100%;
  background: transparent;
  color: #17243a;
}

.filters select {
  height: 40px;
  min-width: 125px;
  border: 1px solid #dce2ec;
  background: #ffffff;
  border-radius: 8px;
  padding: 0 12px;
  color: #26344d;
  outline: none;
}

.filter-label {
  display: flex;
  align-items: center;
  gap: 5px;
  color: #71809a;
  font-size: 13px;
  white-space: nowrap;
}

/* CARDS */

.cards {
  display: grid;
  grid-template-columns:
    repeat(4, minmax(0, 1fr));
  gap: 14px;
  margin-bottom: 14px;
}

.card {
  background: #ffffff;
  border: 1px solid #e0e5ee;
  border-radius: 11px;
  padding: 18px;
  min-height: 125px;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #71809a;
  font-size: 13px;
}

.card-icon {
  color: #17243a;
}

.card > strong {
  display: block;
  margin-top: 18px;
  font-size: 28px;
}

/* DASHBOARD */

.dashboard-panels {
  display: grid;
  grid-template-columns:
    1fr 1fr;
  gap: 14px;
  margin-bottom: 14px;
}

.panel {
  background: #ffffff;
  border: 1px solid #e0e5ee;
  border-radius: 11px;
  padding: 20px;
}

.panel h2 {
  margin: 0;
  font-size: 20px;
}

.panel-subtitle {
  margin: 7px 0 20px;
  color: #7a879c;
  font-size: 13px;
}

.status-list {
  display: flex;
  flex-direction: column;
  gap: 13px;
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 14px;
}

.status-row span {
  color: #53627a;
}

.big-hours {
  margin-top: 10px;
  font-size: 42px;
  font-weight: 800;
}

.summary-grid {
  display: grid;
  grid-template-columns:
    repeat(3, 1fr);
  gap: 12px;
  margin-top: 28px;
}

.summary-grid div {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.summary-grid strong {
  font-size: 20px;
}

.summary-grid span {
  color: #7a879c;
  font-size: 12px;
}

/* TABLE */

.demands-panel {
  padding: 0;
  overflow: hidden;
}

.panel-title {
  padding: 22px 20px;
}

.panel-title h2 {
  margin: 0;
  font-size: 21px;
}

.panel-title p {
  margin: 7px 0 0;
  color: #71809a;
  font-size: 13px;
}

.table-container {
  width: 100%;
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  min-width: 1200px;
}

thead {
  background: #f8f9fc;
}

th {
  text-align: left;
  padding: 13px 12px;
  border-top: 1px solid #e7ebf2;
  border-bottom: 1px solid #e7ebf2;
  color: #60708a;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  white-space: nowrap;
}

td {
  padding: 15px 12px;
  border-bottom: 1px solid #edf0f5;
  color: #27354d;
  font-size: 13px;
  vertical-align: middle;
}

tbody tr:hover {
  background: #fafbfe;
}

.priority,
.status,
.approved {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  white-space: nowrap;
}

.priority {
  color: #44536c;
}

.priority-alta {
  color: #b45309;
  font-weight: 700;
}

.priority-urgente {
  color: #b91c1c;
  font-weight: 700;
}

.status {
  color: #44536c;
}

.approved {
  color: #15803d;
  font-weight: 700;
}

/* ACTIONS */

.action {
  border: 0;
  border-radius: 7px;
  padding: 7px 10px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  font-size: 12px;
  font-weight: 700;
  white-space: nowrap;
}

.action.edit {
  background: #eef2ff;
  color: #3346a8;
}

.action.edit:hover {
  background: #e0e7ff;
}

.action.approve {
  background: #ecfdf3;
  color: #15803d;
}

.action.approve:hover {
  background: #d1fae5;
}

/* EMPTY */

.empty {
  min-height: 250px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  color: #8290a5;
}

.empty strong {
  color: #334155;
  font-size: 15px;
}

.empty span {
  font-size: 13px;
}

/* MODAL */

.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.58);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  z-index: 1000;
}

.modal {
  width: min(720px, 100%);
  max-height: 90vh;
  background: #ffffff;
  border-radius: 16px;
  box-shadow:
    0 25px 60px
    rgba(15, 23, 42, 0.25);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  padding: 25px 28px 20px;
  border-bottom: 1px solid #e8ecf2;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 15px;
}

.modal-header h2 {
  margin: 0;
  font-size: 25px;
}

.modal-header p {
  margin: 6px 0 0;
  color: #71809a;
  font-size: 13px;
}

.close-button {
  width: 38px;
  height: 38px;
  border: 1px solid #dce2ec;
  background: #ffffff;
  border-radius: 8px;
  color: #334155;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-button:hover {
  background: #f4f6f9;
}

.modal-body {
  padding: 25px 28px;
  overflow-y: auto;
}

.form-row {
  display: grid;
  grid-template-columns:
    1fr 1fr;
  gap: 18px;
}

.form-field {
  margin-bottom: 18px;
}

.form-field.full {
  width: 100%;
}

.form-field label {
  display: block;
  margin-bottom: 7px;
  color: #334155;
  font-size: 13px;
  font-weight: 700;
}

.form-field input,
.form-field textarea,
.form-field select {
  width: 100%;
  border: 1px solid #d7deea;
  border-radius: 8px;
  background: #ffffff;
  color: #25334b;
  outline: none;
  padding: 11px 12px;
}

.form-field input,
.form-field select {
  height: 43px;
}

.form-field textarea {
  min-height: 105px;
  resize: vertical;
}

.form-field input:focus,
.form-field textarea:focus,
.form-field select:focus {
  border-color: #63759a;
  box-shadow:
    0 0 0 3px
    rgba(99, 117, 154, 0.12);
}

.form-field input::placeholder,
.form-field textarea::placeholder {
  color: #a2adbd;
}

.modal-footer {
  padding: 17px 28px;
  border-top: 1px solid #e8ecf2;
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  background: #ffffff;
}

/* RESPONSIVO */

@media (max-width: 1000px) {
  .sidebar {
    width: 190px;
  }

  .main {
    width: calc(100% - 190px);
    margin-left: 190px;
    padding: 25px;
  }

  .cards {
    grid-template-columns:
      repeat(2, 1fr);
  }

  .dashboard-panels {
    grid-template-columns: 1fr;
  }

  .filters {
    flex-wrap: wrap;
  }

  .search-box {
    flex-basis: 100%;
  }
}

@media (max-width: 700px) {
  .sidebar {
    position: static;
    width: 100%;
    min-height: auto;
  }

  .app {
    flex-direction: column;
  }

  .main {
    width: 100%;
    margin-left: 0;
    padding: 20px;
  }

  .topbar {
    flex-direction: column;
  }

  .cards {
    grid-template-columns: 1fr;
  }

  .form-row {
    grid-template-columns: 1fr;
    gap: 0;
  }

  .modal {
    max-height: 95vh;
  }

  .modal-header,
  .modal-body,
  .modal-footer {
    padding-left: 18px;
    padding-right: 18px;
  }
}
